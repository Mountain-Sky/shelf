CATALOG_MODE=mock
# Optional server-only AI selection; never use a NEXT_PUBLIC_ key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local diagnostics only; request text is omitted from browser traces.
SHELF_INSPECTOR=0

# npm run demo selects http-demo automatically and starts this local sandbox.
# CATALOG_MODE=http-demo
DEMO_CATALOG_URL=http://127.0.0.1:4310
# Local use needs no password. Docker/private hosting fail closed without one.
SHELF_ACCESS=local
DEMO_ACCESS_PASSWORD=
# Set the exact external HTTPS origin when hosting behind a TLS reverse proxy.
SHELF_PUBLIC_ORIGIN=

# Optional isolated Koha sandbox, never live patron/catalog infrastructure.
# Set CATALOG_MODE=koha in the process environment when using demo/replit runners.
KOHA_SANDBOX_ONLY=0
KOHA_API_URL=
KOHA_CLIENT_ID=
KOHA_CLIENT_SECRET=
# Explicit Shelf branch -> Koha library codes, verified in your sandbox.
KOHA_BRANCH_MAP={}
# Local bibliographic item-type -> print/large-print/audiobook/ebook/unknown.
KOHA_FORMAT_MAP={}
