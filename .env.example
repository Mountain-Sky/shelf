# Safe offline defaults. Next.js loads .env.local automatically.
CATALOG_MODE=mock
# CARL•X mode deliberately fails until the SOAP adapter is implemented.
# No endpoint/authentication variable names are invented before reviewing the working client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SHELF_INSPECTOR=0
SHELF_ACCESS=local
# External cover requests are disabled. Set to openlibrary BEFORE building to opt in.
NEXT_PUBLIC_SHELF_COVERS=off
# Public branch names/codes only; NEVER credentials. Configure with the CARL•X mapping.
# NEXT_PUBLIC_SHELF_BRANCHES='[{"id":"ASH","name":"Ashburn"},{"id":"RUST","name":"Rust"},{"id":"PUR","name":"Purcellville"}]'
NEXT_TELEMETRY_DISABLED=1
