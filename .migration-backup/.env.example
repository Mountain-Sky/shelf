CATALOG_MODE=mock
# Optional server-only AI selection; never use a NEXT_PUBLIC_ key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local diagnostics only; request text is omitted from browser traces.
SHELF_INSPECTOR=0

# npm run demo selects http-demo automatically and starts this local sandbox.
# CATALOG_MODE=http-demo
DEMO_CATALOG_URL=http://127.0.0.1:4310
# Local use needs no password. Docker/private hosting fail closed without one.
SHELF_ACCESS=local
DEMO_ACCESS_PASSWORD=
# Set the exact external HTTPS origin when hosting behind a TLS reverse proxy.
SHELF_PUBLIC_ORIGIN=
