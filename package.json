{
  "name": "shelf-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write app lib scripts tests docs \"*.md\" playwright.config.ts proxy.ts compose.yaml",
    "demo": "tsx scripts/demo.ts",
    "demo:start": "tsx scripts/demo.ts --production",
    "replit:dev": "tsx scripts/demo.ts --replit",
    "replit:start": "tsx scripts/demo.ts --replit --production --reset",
    "catalog:serve": "tsx scripts/catalog-server.ts serve",
    "catalog:set-stock": "tsx scripts/catalog-server.ts set-stock",
    "catalog:reset": "tsx scripts/catalog-server.ts reset",
    "koha:smoke": "tsx scripts/koha-smoke.ts",
    "test:e2e:koha": "playwright test --config playwright.koha.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
