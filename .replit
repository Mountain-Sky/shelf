entrypoint = "app/page.tsx"
modules = ["nodejs-22"]
run = "npm run replit:dev -- --port 5000"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["sh", "-c", "npm run replit:start -- --port 5000"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Shelf Next.js preview"

[[workflows.workflow]]
name = "Shelf Next.js preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run replit:dev -- --port 5000"
